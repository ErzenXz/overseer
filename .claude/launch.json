{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "overseer-hub",
      "runtimeExecutable": "./overseer",
      "runtimeArgs": ["serve", "--addr", ":4200", "--data-dir", "/tmp/overseer-dev-data"],
      "port": 4200
    },
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "site", "run", "dev", "--", "--port", "5180"],
      "port": 5180
    }
  ]
}
